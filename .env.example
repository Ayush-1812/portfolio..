# Web3Forms access key used by the contact form Server Action.
# Create one free at https://web3forms.com using ayushcarpenter1812.work@gmail.com.
# Web3Forms delivers to whichever address the key was registered under, so the
# key MUST be created with the inbox you actually want messages in.
# Server-side only: this is intentionally NOT prefixed with NEXT_PUBLIC_,
# so it never reaches the browser bundle.
WEB3FORMS_KEY=your-web3forms-access-key
